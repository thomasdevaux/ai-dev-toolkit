#!/usr/bin/env bash
# Location-independent toolkit status report: same directory-resolution
# trick as ./toolkit-sync (this script lives in bin/, one level below the
# toolkit root), extended to also capture the caller's cwd as the project to
# report on before changing directory. Prints both scopes (this project's
# `.claude/` and the machine's `~/.claude/`) in one run — each report already
# includes the exact sync command to copy-paste when something's missing or
# drifted.
# Windows counterpart: toolkit-status.cmd — keep both in sync.
set -e

PROJECT_DIR="$(pwd)"
if [ "${1:-}" = "--project-dir" ]; then
    PROJECT_DIR="$2"
fi

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(dirname "$BIN_DIR")"
cd "$TOOLKIT_ROOT"

python -m tools.sync status --toolkit-root "$TOOLKIT_ROOT" --project-dir "$PROJECT_DIR"
echo
echo "(user scope: ~/.claude)"
python -m tools.sync status --toolkit-root "$TOOLKIT_ROOT" --project-dir "$PROJECT_DIR" --user
