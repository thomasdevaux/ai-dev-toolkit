#!/usr/bin/env bash
# Location-independent entrypoint for tools/sync.
#
# `python -m tools.sync ...` only works when the current working directory
# (or PYTHONPATH) already contains the `tools` package, i.e. when the caller
# has `cd`'d into the toolkit checkout first. Forgetting that step fails with
# a cryptic `ModuleNotFoundError: No module named 'tools'` that looks
# unrelated to the real cause. This wrapper resolves its own location — one
# level below the toolkit root, since it lives in bin/ — and `cd`s to the
# root before invoking Python, so it can be called from anywhere.
set -e
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(dirname "$BIN_DIR")"
cd "$TOOLKIT_ROOT"
exec python -m tools.sync "$@"
