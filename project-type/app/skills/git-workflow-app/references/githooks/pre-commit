#!/bin/sh
# Iteration tier: the project's fast gate on every commit. Copy to .githooks/ with
# pre-merge-commit and set FAST_GATE.
#
# A merge finished with `git commit` (a resolved conflict, or following the advice
# Git prints when pre-merge-commit refuses) never reaches pre-merge-commit, so it
# is sent there from here. Without this, that is the way around the merge gate.

FAST_GATE='<the `fast` command from AGENTS.md>'

if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    exec "$(dirname "$0")/pre-merge-commit"
fi

unset $(git rev-parse --local-env-vars)
exec sh -c "$FAST_GATE"
